# Copy to .env.local and adjust per environment.

# Browser-side API base. Empty string = same origin (uses the Next dev proxy
# below, or a reverse proxy in production). Set to an absolute URL when the
# kiosk talks to the API on another host.
NEXT_PUBLIC_API_BASE=""

# Server-side rewrite target for the dev proxy (/api/* -> MES API).
API_ORIGIN=http://localhost:8080

# Station label shown in the header.
NEXT_PUBLIC_STATION_NAME="Zyrex Kiosk"
